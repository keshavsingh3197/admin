<?xml version="1.0" encoding="utf-8"?>
<!--
  Lives in the Docker build context (backend/) so `docker build` can find it. The private
  KeshavSingh.* packages come from GitHub Packages and need a read:packages classic PAT
  supplied via the PACKAGES_READ_TOKEN environment variable / build secret (never committed).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/keshavsingh3197/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="keshavsingh3197" />
      <add key="ClearTextPassword" value="%PACKAGES_READ_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
